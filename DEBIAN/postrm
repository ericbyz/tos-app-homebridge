#!/bin/bash
set -e
APPID="homebridge"
if [ "$1" = "purge" ]; then
    systemctl stop "homebridge.service" 2>/dev/null || true
    id -u "${APPID}" >/dev/null 2>&1 && userdel "${APPID}" 2>/dev/null || true
    rm -rf /var/lib/homebridge /opt/homebridge 2>/dev/null || true
    rm -f /etc/hb-ui-port 2>/dev/null || true
    rm -f /etc/systemd/system/homebridge.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi
exit 0
