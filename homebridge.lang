[zh-cn]
name = "Homebridge 智能家居桥接"
auth = "ericbyz"
descript = "把数百种不支持 HomeKit 的智能家居设备(灯光、窗帘、传感器、开关等)接入苹果“家庭”App,并全程用网页控制台管理:http://<NAS>:18246。插件市场一键安装、设备配对、日志与备份一应俱全。自带独立 Node.js 运行时,不依赖系统组件;上游官方 deb 原样封装(Apache-2.0)。"
note = "1. 将上游官方 homebridge-apt-pkg deb(Apache-2.0)原样封装为 TOS 应用。"

[zh-hk]
name = "Homebridge 智能家居橋接"
auth = "ericbyz"
descript = "把數百種不支持 HomeKit 的智能家居設備(燈光、窗簾、傳感器、開關等)接入蘋果“家庭”App,並全程用網頁控制台管理:http://<NAS>:18246。插件市場一鍵安裝、設備配對、日誌與備份一應俱全。自帶獨立 Node.js 運行時,不依賴系統組件;上游官方 deb 原樣封裝(Apache-2.0)。"
note = "1. 将上游官方 homebridge-apt-pkg deb(Apache-2.0)原样封装为 TOS 应用。"

[en-us]
name = "Homebridge Smart Home Bridge"
auth = "ericbyz"
descript = "Bridge hundreds of smart-home accessories that don't natively support HomeKit into Apple Home — lights, blinds, sensors, switches and more — and manage everything from the web UI at http://<NAS>:18246: one-click plugin marketplace, device pairing, logs and backup. Ships its own Node.js runtime (zero system dependencies). Packaged unmodified from the official upstream deb (Apache-2.0)."
note = "1. Repackaged the official upstream homebridge-apt-pkg deb (Apache-2.0) unmodified for TOS."

[ko-kr]
